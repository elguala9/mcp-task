{
  "name": "@elguala9/mcp-task",
  "version": "0.1.0",
  "description": "Local MCP server + CLI for managing development tasks as Markdown files, no database required",
  "type": "module",
  "license": "MIT",
  "author": "Luca Gualandi",
  "homepage": "https://github.com/elguala9/mcp-task#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elguala9/mcp-task.git"
  },
  "bugs": {
    "url": "https://github.com/elguala9/mcp-task/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "task-manager",
    "markdown",
    "cli",
    "ai-agent",
    "claude"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "mcp-task": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "task-config-example.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "pretest": "node -e \"require('fs').rmSync('test/.sandbox',{recursive:true,force:true})\"",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.9",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
