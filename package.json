{
  "name": "mcp-task-manager",
  "version": "0.1.0",
  "description": "Local MCP server + CLI for managing Markdown-based development tasks",
  "type": "module",
  "bin": {
    "mcp-task-manager": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "pretest": "node -e \"require('fs').rmSync('test/.sandbox',{recursive:true,force:true})\"",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.9",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
